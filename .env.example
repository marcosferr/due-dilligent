# Copiar a .env (no se versiona) o exportar en la shell antes de abrir Claude Code.

# Modo de las fuentes: "real" (por defecto) consulta las APIs públicas;
# "mock" usa los datos ficticios de data/mocks/ (para demos sin red).
DD_MODO=real

# Carpeta de datos en tiempo de ejecución (base SQLite, capturas, descargas, fichas).
DD_HOME=./var

# DNCP API v3. Sin token: 15 llamadas por minuto (solo pruebas).
# Con request token del portal de datos: el servidor obtiene un access token de 15 min.
DNCP_REQUEST_TOKEN=
DNCP_LLAMADAS_POR_MINUTO=15

# Opcionales: si faltan, la consulta se registra como brecha de información.
OPENCORPORATES_API_TOKEN=
SAM_API_KEY=
